# VGIS Django 框架 —— 环境变量样例（Stage A）
# 复制为 .env 后按需改；config.py 中所有变量都能用同名环境变量覆盖。
# 真上线时建议把敏感值（密码/密钥）放 .env，不入库（.env 已 .gitignore）。

# ============================================================================
# 数据库（主库 —— 直连 PG 18.4 / PostGIS）
# ============================================================================
# 默认库名（在 mydb_test 测，不动 MYDB）
DB_DEFAULT_NAME=mydb_test
DB_DEFAULT_USER=postgres
DB_DEFAULT_PASSWORD=postgres
DB_DEFAULT_HOST=192.168.3.40
DB_DEFAULT_PORT=12326

# 连接硬化（libpq 选项）
DB_CONNECT_TIMEOUT=10
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=5
DB_CONN_MAX_AGE=60

# ============================================================================
# 数据库（读副本，默认关闭 —— 改 true 后才启用 replica alias + 路由）
# ============================================================================
DB_REPLICA_ENABLED=false
DB_REPLICA_NAME=mydb_test
DB_REPLICA_USER=readonly_user
DB_REPLICA_PASSWORD=
DB_REPLICA_HOST=192.168.3.40
DB_REPLICA_PORT=12326

# ============================================================================
# pgbouncer（默认关闭 —— 改 true 后所有 alias 的 HOST/PORT 都指向 pgbouncer）
# ============================================================================
PGBOUNCER_ENABLED=false
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432

# ============================================================================
# Redis（缓存 / channels / celery broker 同一台物理机，按 DB 隔离）
# ============================================================================
REDIS_HOST=192.168.3.80
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_CHANNEL=1
REDIS_DB_CELERY=2
# 该服务器 Redis 5.x 不支持 HELLO，强制 RESP2；将来升 6.x 后可去掉
REDIS_PROTOCOL=2

# ============================================================================
# Elasticsearch（异步日志）
# ============================================================================
ES_ENABLED=true
ES_HOSTS=http://192.168.3.40:9200
ES_USER=elastic
ES_PASSWORD=VgisES@2026!
ES_INDEX_PREFIX=vgis-myapp
ES_FLUSH_INTERVAL=1.0
ES_BATCH_SIZE=100

# ============================================================================
# gis_service 模块（Stage H+ 启用，默认空跑不影响主框架）
# ============================================================================
# Celery worker 在 40 服务器上跑时会用
GIS_SSH_HOST=192.168.3.40
GIS_SSH_PORT=22
GIS_SSH_USER=root
GIS_SSH_PASSWORD=qwer1234

GIS_MINIO_ENDPOINT=http://192.168.3.40:9000
GIS_MINIO_USER=minioadmin
GIS_MINIO_PASSWORD=minioadmin123
GIS_MINIO_BUCKET=stac-demo

GIS_TITILER_URL=http://192.168.3.40:8001
GIS_PGSTAC_DSN=postgresql://pgstac:pgstac123@192.168.3.40:5433/pgstac
GIS_NGINX_HOST=192.168.3.40
GIS_NGINX_PORT=8080
GIS_WORK_DIR=/mnt/data/cog_publish